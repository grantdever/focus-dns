# Copy to ~/.config/focus/nextdns.env and chmod 600. Never commit the real file (.gitignore covers *.env).

# NextDNS: Account page -> API key. The profile id is the 6 characters in https://my.nextdns.io/<id>/setup
NEXTDNS_PROFILE=abc123
NEXTDNS_API_KEY=replace-me

# This machine's Tailscale IPv4 (`tailscale ip -4`). bin/install-unit fills it in when it is missing.
# FOCUS_TAILNET_IP=100.x.y.z

# NextDNS device names that are machines, not people (the server itself, a dev box). Their lookups count
# toward the monthly cap but never become "time online". Comma-separated, optional.
# FOCUS_EXCLUDE_DEVICES=server
